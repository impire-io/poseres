<?xml version="1.0" encoding="UTF-8"?>
<lexicon version="1.0"
  xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon
  http://www.w3.org/TR/2007/CR-pronunciation-lexicon-20071212/pls.xsd"
  alphabet="ipa" xml:lang="en-GB">
  <!-- no spoken hyphen -->
  <lexeme>
    <grapheme>diff-drive</grapheme>
    <alias>diff drive</alias>
  </lexeme>
  <!-- the demo command -->
  <lexeme>
    <grapheme>pra-rover</grapheme>
    <alias>P R A rover</alias>
  </lexeme>
  <!-- technical asides only -->
  <lexeme>
    <grapheme>Frobenius</grapheme>
    <alias>fro bee nee us</alias>
  </lexeme>
  <!-- two words -->
  <lexeme>
    <grapheme>CartPole</grapheme>
    <alias>Cart Pole</alias>
  </lexeme>
  <lexeme>
    <grapheme>odometry</grapheme>
    <alias>oh dom uh tree</alias>
  </lexeme>
  <!-- the package name -->
  <lexeme>
    <grapheme>poseres</grapheme>
    <alias>pohz res</alias>
  </lexeme>
  <!-- Dutch. VERIFY WITH THE AUTHOR before use. -->
  <lexeme>
    <grapheme>Gerits</grapheme>
    <alias>Herits</alias>
  </lexeme>
  <!-- not spelled out -->
  <lexeme>
    <grapheme>lidar</grapheme>
    <alias>LY dar</alias>
  </lexeme>
  <!-- robotics framework -->
  <lexeme>
    <grapheme>ROS2</grapheme>
    <alias>ross two</alias>
  </lexeme>
  <!-- Dutch. VERIFY WITH THE AUTHOR before use. -->
  <lexeme>
    <grapheme>Daan</grapheme>
    <alias>Dahn</alias>
  </lexeme>
  <!-- the architecture. Never &#x27;prah&#x27;. -->
  <lexeme>
    <grapheme>PRA</grapheme>
    <alias>P R A</alias>
  </lexeme>
  <!-- unit in the last place -->
  <lexeme>
    <grapheme>ULP</grapheme>
    <alias>U L P</alias>
  </lexeme>
</lexicon>
