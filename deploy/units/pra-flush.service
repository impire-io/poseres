[Unit]
Description=PRA observatory flusher: JetStream 1h buffer -> S3 (feature 032)
After=network-online.target

StartLimitIntervalSec=0

[Service]
User=calmera
WorkingDirectory=/home/calmera/pra
EnvironmentFile=/etc/pra/s3.env
ExecStart=/home/calmera/pra/.venv/bin/pra-flush --url nats://127.0.0.1:4222 \
  --snapshot-dir /home/calmera/pra-runs/c1b/snapshots --snapshot-keep 5
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
