[Unit]
Description=PRA Minecraft bridge for experiment %i (the body's transport)
After=network-online.target docker.service

StartLimitIntervalSec=0

[Service]
User=calmera
WorkingDirectory=/home/calmera/pra/examples/minecraft/bridge
EnvironmentFile=/etc/pra/%i.env
ExecStart=/usr/bin/env node bridge.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
