# Copied to /etc/pra/s3.env by provision.sh if absent. Default: the on-node
# MinIO. For real S3: set the endpoint empty (AWS) or your endpoint, plus
# bucket + credentials, then: sudo systemctl restart pra-flush
PRA_S3_BUCKET=pra-telemetry
PRA_S3_ENDPOINT=http://127.0.0.1:9100
AWS_ACCESS_KEY_ID=pra
AWS_SECRET_ACCESS_KEY=pra-observatory
AWS_DEFAULT_REGION=us-east-1
# Per-run snapshot store the flusher mirrors to S3 and prunes to newest-N
# (e.g. /home/calmera/pra-runs/<run>/snapshots). Empty disables mirroring.
# Set it when a run starts; it must move with the run id.
PRA_SNAPSHOT_DIR=
